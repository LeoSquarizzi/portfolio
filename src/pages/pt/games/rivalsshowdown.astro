---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Button from '../../../components/Button.astro';

const game = {
  title: 'Rivals Showdown',
  tagline: 'Esportes · Mobile · 3D',
  shortDescription:
    'Planeje formações, atribua rotas e defina estratégias como head coach, enquanto vivencia momentos-chave em campo como jogador.',
  snapshop: {
    developer: 'YahP Games',
    timeOnProject: '3 meses',
    engine: 'Unity',
    partners: 'A.A.Ponte Preta [American Football]',
  },

  links: [
    {
      label: 'Devlog',
      href: 'https://docs.google.com/document/d/1imW8XPVHdd-NgGb0aNNs9rpTGDLC_1NfJSDO4HFMefg/edit?usp=sharing',
      external: true,
    },
    {
      label: 'GDD',
      href: 'https://docs.google.com/document/d/1imW8XPVHdd-NgGb0aNNs9rpTGDLC_1NfJSDO4HFMefg/edit?usp=sharing',
      external: true,
    },
  ],

  resp_midia: '/img/rivals/Menu.jpg',

  responsibilities: [
    'Conceito do jogo e design dos sistemas principais',
    'Design do sistema de formações e planejamento de rotas',
    'Arquitetura e comportamento de AI',
    'Implementação dos sistemas de gameplay na Unity',
    'GDD completo e documentação de desenvolvimento',
  ],
  role: 'Game Designer · Game Developer · Tech Designer',
};

const highlight_1_Images = ['/img/rivals/LinePlan.png', '/img/rivals/LinePlan2.png'];

const highlight_2_Images = [
  '/img/rivals/IA.png',
  '/img/rivals/IA2.png',
  '/img/rivals/IA3.png',
  '/img/rivals/IA4.png',
  '/img/rivals/IA5.png',
];

const getLinkIcon = (label: string) => {
  const key = label.toLowerCase();

  // Google Play
  if (key.includes('google') || key.includes('play')) {
    return `
      <svg viewBox="0 0 24 24" class="w-5 h-5" aria-hidden="true">
        <path fill="currentColor" d="M3.9 2.7c-.3.3-.4.8-.4 1.3v16c0 .5.1 1 .4 1.3l.1.1L13 12 4 2.6l-.1.1Zm10 9.2 2.6-2.6-9-5.2 6.4 7.8Zm3.6 0 2.5-1.5c.9-.5.9-1.3 0-1.8L17.5 7 14.8 9.6l2.7 2.3Zm-3.6.2L7.5 19.9l9-5.2-2.6-2.6Z"/>
      </svg>
    `;
  }

  // App Store (iOS)
  if (key.includes('app') || key.includes('ios') || key.includes('store')) {
    return `
      <svg viewBox="0 0 24 24" class="w-5 h-5" aria-hidden="true">
        <path fill="currentColor" d="M16.4 13.2l-2.9-5.1c-.2-.4-.7-.6-1.1-.4-.4.2-.6.7-.4 1.1l2.9 5.1h1.5ZM10.9 13.2L8 8.1c-.2-.4-.7-.6-1.1-.4-.4.2-.6.7-.4 1.1l2.8 4.9.1.1h1.5Zm8.2 5.6H4.9c-.5 0-.9.4-.9.9s.4.9.9.9h14.2c.5 0 .9-.4.9-.9s-.4-.9-.9-.9ZM13.9 4.1c.6-.7 1-1.6.9-2.6-1 .1-1.9.6-2.5 1.3-.6.7-1 1.6-.9 2.6 1-.1 1.9-.6 2.5-1.3Z"/>
        <path fill="currentColor" d="M20 16.2c-1.5 0-2.3-.7-3.1-1.4-.7-.6-1.3-1.1-2.4-1.1-1.1 0-1.7.5-2.4 1.1-.8.7-1.6 1.4-3.1 1.4s-2.3-.7-3.1-1.4c-.3-.3-.6-.5-.9-.7-.4-.2-.6-.7-.4-1.1.2-.4.7-.6 1.1-.4.5.3.9.6 1.3.9.7.6 1.3 1.1 2 .9.8 0 1.3-.4 2-1 .8-.7 1.8-1.6 3.5-1.6s2.7.9 3.5 1.6c.7.6 1.2 1 2 1 .2 0 .4 0 .6-.1.5-.1.9.2 1 .6.1.5-.2.9-.6 1-.4.2-.8.3-1.2.3Z"/>
      </svg>
    `;
  }

  // GDD (document)
  if (key.includes('gdd')) {
    return `
      <svg viewBox="0 0 24 24" class="w-5 h-5" aria-hidden="true">
        <path fill="currentColor" d="M7 3h7l5 5v13c0 1.1-.9 2-2 2H7c-1.1 0-2-.9-2-2V5c0-1.1.9-2 2-2Zm7 1.5V9h4.5L14 4.5ZM8 12c0-.6.4-1 1-1h6c.6 0 1 .4 1 1s-.4 1-1 1H9c-.6 0-1-.4-1-1Zm0 4c0-.6.4-1 1-1h6c.6 0 1 .4 1 1s-.4 1-1 1H9c-.6 0-1-.4-1-1Z"/>
      </svg>
    `;
  }

  // PC
  return `
    <svg viewBox="0 0 24 24" class="w-5 h-5" aria-hidden="true">
      <path fill="currentColor" d="M4 5.5C4 4.7 4.7 4 5.5 4h13C19.3 4 20 4.7 20 5.5v9C20 15.3 19.3 16 18.5 16H13v2h2c.5 0 1 .4 1 1s-.5 1-1 1H9c-.5 0-1-.4-1-1s.5-1 1-1h2v-2H5.5C4.7 16 4 15.3 4 14.5v-9Zm1.5.5v8.5h13V6h-13Z"/>
    </svg>
  `;
};
---

<BaseLayout title={`${game.title} - Leonardo Squarizzi`} description={game.shortDescription}>
  <Header currentPage="games" />

  <main class="pt-[72px]">
    <!-- Header / Hero -->
    <section class="py-12 md:py-16 bg-bg-primary">
      <div class="container">
        <div class="max-w-4xl mx-auto text-center flex flex-col items-center">
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-text-primary mb-4" data-animate="fade-up">
            {game.title}
          </h1>

          <p class="text-sm md:text-base text-text-muted mb-8" data-animate="fade-up" data-delay="80">
            {game.tagline}
          </p>

          <p
            class="text-base md:text-lg text-text-secondary max-w-3xl text-center"
            data-animate="fade-up"
            data-delay="120">
            {game.shortDescription}
          </p>

          <!-- Info Boxes -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6 mt-10" data-animate="fade-up" data-delay="160">
            <!-- Box Snapshot -->
            <div class="bg-bg-card border border-border-default rounded-2xl p-6">
              <p class="text-xs font-semibold text-accent-coral uppercase tracking-widest mb-4">Resumo do Projeto</p>

              <ul class="space-y-2 text-sm text-text-secondary">
                <li class="flex items-start gap-3">
                  <span class="mt-1.5 w-2 h-2 rounded-full bg-accent-coral flex-shrink-0"></span>
                  <span><span class="text-text-muted">Developer:</span> {game.snapshop.developer}</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="mt-1.5 w-2 h-2 rounded-full bg-accent-coral flex-shrink-0"></span>
                  <span><span class="text-text-muted">Engine:</span> {game.snapshop.engine}</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="mt-1.5 w-2 h-2 rounded-full bg-accent-coral flex-shrink-0"></span>
                  <span><span class="text-text-muted">Tempo no Projeto:</span> {game.snapshop.timeOnProject}</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="mt-1.5 w-2 h-2 rounded-full bg-accent-coral flex-shrink-0"></span>
                  <span><span class="text-text-muted">Parceiros:</span> {game.snapshop.partners}</span>
                </li>
              </ul>
            </div>

            <!-- Box Links -->
            <div class="bg-bg-card border border-border-default rounded-2xl p-6">
              <p class="text-xs font-semibold text-accent-coral uppercase tracking-widest mb-4">Links</p>

              <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm w-full">
                {
                  game.links.map((link) => (
                    <li>
                      <a
                        href={link.href}
                        target={link.external ? '_blank' : undefined}
                        rel={link.external ? 'noreferrer' : undefined}
                        class="w-full flex items-center gap-3 rounded-xl border border-border-default bg-bg-primary px-4 py-3
                             text-text-secondary hover:text-text-primary hover:border-text-primary/30 transition-colors">
                        <span class="w-9 h-9 rounded-lg bg-bg-card border border-border-default flex items-center justify-center text-accent-coral">
                          <span set:html={getLinkIcon(link.label)} />
                        </span>

                        <span class="font-medium">{link.label}</span>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Responsibilities -->
    <section class="py-12 md:py-16 bg-bg-secondary">
      <div class="container">
        <div class="max-w-5xl mx-auto">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
            <div
              class="bg-bg-card border border-border-default rounded-2xl overflow-hidden"
              data-animate="fade-up"
              data-delay="120">
              <div class="bg-bg-card border border-border-default rounded-2xl overflow-hidden">
                <img src="/img/rivals/Menu.jpg" alt="Rivals Showdown Menu" class="w-full object-cover" />
              </div>
            </div>

            <!-- Right: text -->
            <div>
              <h2 class="text-2xl md:text-3xl font-bold text-text-primary mb-2" data-animate="fade-up">
                Meu Papel e Contribuições
              </h2>

              <p
                class="text-xs font-semibold text-accent-coral uppercase tracking-widest mb-6"
                data-animate="fade-up"
                data-delay="40">
                {game.role}
              </p>

              <ul class="space-y-3 text-text-secondary" data-animate="fade-up" data-delay="80">
                {
                  game.responsibilities.map((item) => (
                    <li class="flex items-start gap-3">
                      <span class="mt-2 w-2 h-2 rounded-full bg-accent-coral flex-shrink-0" />
                      <span>{item}</span>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Divider -->
    <div class="flex items-center gap-4 my-12" data-animate="fade-up">
      <span class="flex-1 h-px bg-border-default"></span>

      <span class="text-xs font-semibold text-text-muted uppercase tracking-widest whitespace-nowrap">
        Destaques do Projeto
      </span>

      <span class="flex-1 h-px bg-border-default"></span>
    </div>

    <!-- Highlight 01 -->
    <section class="py-6 md:py-8">
      <div class="container">
        <div class="max-w-5xl mx-auto">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
            <!-- Text -->
            <div data-animate="fade-up">
              <h3 class="text-xl md:text-2xl font-bold text-text-primary mb-0">
                Sistema de Formações e Planejamento de Rotas
              </h3>

              <p class="text-xs font-semibold text-accent-coral uppercase tracking-widest mb-5 text-left max-w-6xl mx-auto">
                Game Designer · Design de Sistemas · UX
              </p>

              <div class="space-y-5 text-text-secondary text-sm md:text-base">
                <div>
                  <p class="font-semibold text-text-primary mb-1">🟥 O Problema</p>
                  <p>
                    A estratégia no American Football é complexa. No mobile, muitas opções de formação e rota geravam
                    confusão visual e reduziam a clareza de papéis.
                  </p>
                </div>

                <div>
                  <p class="font-semibold text-text-primary mb-1">🟨 O Que Eu Fiz</p>
                  <ul class="list-disc pl-5 space-y-1 text-[16px] mb-2">
                    <li>Desenhei o sistema de formação do time com âncoras de posição fixas</li>
                    <li>Restringi opções de rota dinamicamente com base no papel do jogador</li>
                    <li>Implementei ajustes automáticos de posição para melhorar a leitura</li>
                    <li>Reduzi overload de UI mantendo liberdade estratégica</li>
                  </ul>
                </div>

                <div>
                  <p class="font-semibold text-text-primary mb-1">🟩 Resultado</p>
                  <ul class="list-disc pl-5 space-y-1 text-[16px] mb-2">
                    <li>Melhor clareza das estratégias e leitura tática</li>
                    <li>Rotas do jogador sem “poluir” a tela</li>
                    <li>Estabeleceu um sistema escalável para novas formações</li>
                  </ul>
                </div>
              </div>
            </div>

            <!-- Slider -->
            <div class="flex flex-col gap-6">
              <div class="bg-bg-card border border-border-default rounded-2xl overflow-hidden relative" data-slider="city-1">
                <div class="relative w-full aspect-video">
                  {
                    highlight_1_Images.map((src, i) => (
                      <img
                        src={src}
                        alt={`Highlight 1 ${i + 1}`}
                        class={`absolute inset-0 w-full h-full object-cover transition-opacity duration-500 ${
                          i === 0 ? 'opacity-100' : 'opacity-0'
                        }`}
                        data-slide="city-1"
                      />
                    ))
                  }
                </div>

                <button
                  type="button"
                  class="absolute left-3 top-1/2 -translate-y-1/2 w-10 h-10 rounded-xl bg-bg-card/80 border border-border-default text-text-primary flex items-center justify-center hover:bg-bg-card transition-colors"
                  data-prev="city-1"
                  aria-label="Imagem Anterior">
                  ‹
                </button>

                <button
                  type="button"
                  class="absolute right-3 top-1/2 -translate-y-1/2 w-10 h-10 rounded-xl bg-bg-card/80 border border-border-default text-text-primary flex items-center justify-center hover:bg-bg-card transition-colors"
                  data-next="city-1"
                  aria-label="Próxima Imagem">
                  ›
                </button>

                <div class="absolute bottom-3 left-1/2 -translate-x-1/2 flex gap-2">
                  {
                    highlight_1_Images.map((_, i) => (
                      <button
                        type="button"
                        class={`w-2.5 h-2.5 rounded-full border border-border-default ${
                          i === 0 ? 'bg-accent-coral' : 'bg-bg-card/60'
                        }`}
                        data-dot="city-1"
                        data-index={i}
                        aria-label={`Ir Para a Imagem ${i + 1}`}
                      />
                    ))
                  }
                </div>
              </div>

              <div class="bg-bg-card border border-border-default rounded-2xl overflow-hidden">
                <img src="/img/rivals/LinesPlanGame.gif" alt="Planejamento de Rotas" class="w-full object-cover" />
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Highlight 02 -->
    <section class="py-6 md:py-8">
      <div class="container">
        <div class="max-w-5xl mx-auto">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
            <!-- LEFT SIDE -->
            <div class="flex flex-col gap-6">
              <div class="bg-bg-card border border-border-default rounded-2xl overflow-hidden relative" data-slider="city-2">
                <div class="relative w-full aspect-video">
                  {
                    highlight_2_Images.map((src, i) => (
                      <img
                        src={src}
                        alt={`Highlight 2 ${i + 1}`}
                        class={`absolute inset-0 w-full h-full object-cover transition-opacity duration-500 ${
                          i === 0 ? 'opacity-100' : 'opacity-0'
                        }`}
                        data-slide="city-2"
                      />
                    ))
                  }
                </div>

                <button
                  type="button"
                  class="absolute left-3 top-1/2 -translate-y-1/2 w-10 h-10 rounded-xl bg-bg-card/80 border border-border-default text-text-primary flex items-center justify-center hover:bg-bg-card transition-colors"
                  data-prev="city-2"
                  aria-label="Imagem Anterior">
                  ‹
                </button>

                <button
                  type="button"
                  class="absolute right-3 top-1/2 -translate-y-1/2 w-10 h-10 rounded-xl bg-bg-card/80 border border-border-default text-text-primary flex items-center justify-center hover:bg-bg-card transition-colors"
                  data-next="city-2"
                  aria-label="Próxima Imagem">
                  ›
                </button>

                <div class="absolute bottom-3 left-1/2 -translate-x-1/2 flex gap-2">
                  {
                    highlight_2_Images.map((_, i) => (
                      <button
                        type="button"
                        class={`w-2.5 h-2.5 rounded-full border border-border-default ${
                          i === 0 ? 'bg-accent-coral' : 'bg-bg-card/60'
                        }`}
                        data-dot="city-2"
                        data-index={i}
                        aria-label={`Ir Para a Imagem ${i + 1}`}
                      />
                    ))
                  }
                </div>
              </div>

              <div class="bg-bg-card border border-border-default rounded-2xl overflow-hidden">
                <img src="/img/rivals/Formation.gif" alt="Formação" class="w-full object-cover" />
              </div>
            </div>

            <!-- Text (Right) -->
            <div data-animate="fade-up">
              <h3 class="text-xl md:text-2xl font-bold text-text-primary mb-0">AI da CPU</h3>

              <p class="text-xs font-semibold text-accent-coral uppercase tracking-widest mb-5 text-left">
                Tech Design · AI Design · Gameplay Design
              </p>

              <div class="space-y-5 text-text-secondary text-sm md:text-base">
                <div>
                  <p class="font-semibold text-text-primary mb-1">🟥 O Problema</p>
                  <p>
                    O comportamento defensivo precisava parecer coordenado e estratégico, mantendo baixo custo para
                    performance em mobile.
                  </p>
                </div>

                <div>
                  <p class="font-semibold text-text-primary mb-1 mt-2">🟨 O Que Eu Fiz</p>
                  <ul class="list-disc pl-5 space-y-1 text-[16px] mb-2">
                    <li>Desenhei um sistema de detecção por quadrantes ao redor de cada defensor</li>
                    <li>Implementei priorização de alvo baseada em distância</li>
                    <li>Evitei overlap de defensores e lógica de IA compartilhada</li>
                    <li>Estruturei comportamento condicional para cenários com múltiplos alvos</li>
                  </ul>
                </div>

                <div>
                  <p class="font-semibold text-text-primary mb-1 mt-2">🟩 Resultado</p>
                  <ul class="list-disc pl-5 space-y-1 text-[16px] mb-1">
                    <li>Coordenação defensiva mais crível</li>
                    <li>Menos comportamento caótico de targeting</li>
                    <li>Lógica de AI escalável com baixo custo de processamento</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Divider -->
    <div class="flex items-center gap-4 my-3" data-animate="fade-up">
      <span class="flex-1 h-px bg-border-default"></span>
      <span class="text-xs font-semibold text-text-muted uppercase tracking-widest whitespace-nowrap">
        Outras contribuições
      </span>
      <span class="flex-1 h-px bg-border-default"></span>
    </div>

    <!-- Other Highlights -->
    <section class="mt-8 mb-8">
      <div class="container">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <!-- Card 1 -->
          <div class="bg-bg-card border border-border-default rounded-2xl p-5">
            <img src="/img/rivals/Throw.jpg" class="w-full h-40 object-cover rounded-xl mb-4" />

            <p class="text-sm font-semibold text-text-primary mb-3">Sistemas Principais de Arremesso e Field Goal</p>

            <ul class="space-y-2 text-sm text-text-secondary">
              <li class="flex items-start gap-3">
                <span class="mt-1.5 w-2 h-2 rounded-full bg-accent-coral flex-shrink-0"></span>
                <span>Refiz o arremesso do quarterback para precisão e controle</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-1.5 w-2 h-2 rounded-full bg-accent-coral flex-shrink-0"></span>
                <span>Reaproveitei a mecânica de arremesso para o modo de field goal</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-1.5 w-2 h-2 rounded-full bg-accent-coral flex-shrink-0"></span>
                <span>Melhorei eficiência do sistema para melhor game feel</span>
              </li>
            </ul>
          </div>

          <!-- Card 2 -->
          <div class="bg-bg-card border border-border-default rounded-2xl p-5">
            <img src="/img/rivals/Runner2.gif" class="w-full h-40 object-cover rounded-xl mb-4" />

            <p class="text-sm font-semibold text-text-primary mb-3">Balanceamento e Interações Defensivas</p>

            <ul class="space-y-2 text-sm text-text-secondary">
              <li class="flex items-start gap-3">
                <span class="mt-1.5 w-2 h-2 rounded-full bg-accent-coral flex-shrink-0"></span>
                <span>Desenhei mecânica de corrida, dodge e interações</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-1.5 w-2 h-2 rounded-full bg-accent-coral flex-shrink-0"></span>
                <span>Implementei mecânica de jump e impacto para defensores</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-1.5 w-2 h-2 rounded-full bg-accent-coral flex-shrink-0"></span>
                <span>Rebalanceei IA de defensores e adicionei bloqueio de aliados</span>
              </li>
            </ul>
          </div>

          <!-- Card 3 -->
          <div class="bg-bg-card border border-border-default rounded-2xl p-5">
            <img src="/img/rivals/Zones.png" class="w-full h-40 object-cover rounded-xl mb-4" />

            <p class="text-sm font-semibold text-text-primary mb-3">Documentação de Sistemas e Pesquisa</p>

            <ul class="space-y-2 text-sm text-text-secondary">
              <li class="flex items-start gap-3">
                <span class="mt-1.5 w-2 h-2 rounded-full bg-accent-coral flex-shrink-0"></span>
                <span>Escrevi o GDD completo</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-1.5 w-2 h-2 rounded-full bg-accent-coral flex-shrink-0"></span>
                <span>Documentei o processo de desenvolvimento (devlog)</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-1.5 w-2 h-2 rounded-full bg-accent-coral flex-shrink-0"></span>
                <span>Pesquisei e traduzi regras do esporte real em sistemas de gameplay</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<Footer />

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.querySelectorAll('[data-animate="fade-up"]').forEach((el) => {
    const delay = parseInt(el.getAttribute('data-delay') || '0') / 1000;

    gsap.from(el, {
      scrollTrigger: {
        trigger: el,
        start: 'top 85%',
        toggleActions: 'play none none none',
      },
      y: 30,
      opacity: 0,
      duration: 0.6,
      delay,
      ease: 'power2.out',
    });
  });
</script>

<script>
  const setupSlider = (id, intervalMs = 45000) => {
    const slides = Array.from(document.querySelectorAll(`img[data-slide="${id}"]`));
    const prevBtn = document.querySelector(`[data-prev="${id}"]`);
    const nextBtn = document.querySelector(`[data-next="${id}"]`);
    const dots = Array.from(document.querySelectorAll(`button[data-dot="${id}"]`));
    const container = document.querySelector(`[data-slider="${id}"]`);

    if (!slides.length) return;

    let index = 0;
    let timer = null;

    const render = (newIndex) => {
      index = (newIndex + slides.length) % slides.length;

      slides.forEach((el, i) => {
        el.classList.toggle('opacity-100', i === index);
        el.classList.toggle('opacity-0', i !== index);
      });

      dots.forEach((d, i) => {
        d.classList.toggle('bg-accent-coral', i === index);
        d.classList.toggle('bg-bg-card/60', i !== index);
      });
    };

    const start = () => {
      stop();
      timer = setInterval(() => render(index + 1), intervalMs);
    };

    const stop = () => {
      if (timer) clearInterval(timer);
      timer = null;
    };

    prevBtn?.addEventListener('click', () => {
      render(index - 1);
      start();
    });
    nextBtn?.addEventListener('click', () => {
      render(index + 1);
      start();
    });

    dots.forEach((d) => {
      d.addEventListener('click', () => {
        const i = parseInt(d.getAttribute('data-index') || '0', 10);
        render(i);
        start();
      });
    });

    container?.addEventListener('mouseenter', stop);
    container?.addEventListener('mouseleave', start);

    render(0);
    start();
  };

  document.querySelectorAll('[data-slider]').forEach((el) => {
    const id = el.getAttribute('data-slider');
    if (id) setupSlider(id);
  });
</script>