---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Button from '../../../components/Button.astro';

const game = {
  title: 'Save the Boat',
  tagline: 'Arcade · Casual · 2D · Mobile',
  shortDescription:
    'Um jogo arcade para celular, dinâmico e focado na velocidade do jogador, com padrões de inimigos e mecânicas de chefes.',
  snapshop: {
    developer: 'Talking Capybara [Solo Dev]',
    timeOnProject: '1 month',
    engine: 'Unity',
  },

  links: [
    {
      label: 'Google Play',
      href: 'https://play.google.com/store/apps/details?id=com.TalkingCapybara.SavetheBoat',
      external: true,
    },
    {
      label: 'GDD',
      href: 'https://docs.google.com/document/d/12L4kcsp8adTPpRHMj7mOEM7qgdFPJ2VNJx9WAVE16O4/edit?usp=sharing',
      external: true,
    },
    {
      label: 'Log Dev Process',
      href: 'https://docs.google.com/document/d/1ucuy_hDa28YrWVej-RltEkhVWa5292zFdE8gSDY1r1I/edit?usp=sharing',
      external: true,
    },
  ],

  resp_midia: '4x8_TYs5_A8',

  responsibilities: [
    'Led game design delivery (documentation, planning, and team coordination)',
    'Tech design alignment (feasibility, adapting mechanics to Phaser/platform constraints)',
    'Designed all four adventures (level structure, pacing, progression)',
    'Guided UI/UX adaptation for the remaster (flows, readability, interaction beats)',
    'Cataloged and remastered 150+ assets for reuse in the new build',
  ],
  role: 'Lead Game Designer · Tech Design · Level Designer',
};

const highlight_1_Images = ['/img/savetheboat/sketch.jpg', '/img/savetheboat/sketch2.png'];

const highlight_2_Images = ['/img/literama/origami1.png', '/img/literama/origami2.png'];

const getLinkIcon = (label: string) => {
  const key = label.toLowerCase();

  // Google Play
  if (key.includes('google') || key.includes('play')) {
    return `
      <svg viewBox="0 0 24 24" class="w-5 h-5" aria-hidden="true">
        <path fill="currentColor" d="M3.9 2.7c-.3.3-.4.8-.4 1.3v16c0 .5.1 1 .4 1.3l.1.1L13 12 4 2.6l-.1.1Zm10 9.2 2.6-2.6-9-5.2 6.4 7.8Zm3.6 0 2.5-1.5c.9-.5.9-1.3 0-1.8L17.5 7 14.8 9.6l2.7 2.3Zm-3.6.2L7.5 19.9l9-5.2-2.6-2.6Z"/>
      </svg>
    `;
  }

  // GDD (document)
  if (key.includes('gdd')) {
    return `
      <svg viewBox="0 0 24 24" class="w-5 h-5" aria-hidden="true">
        <path fill="currentColor" d="M7 3h7l5 5v13c0 1.1-.9 2-2 2H7c-1.1 0-2-.9-2-2V5c0-1.1.9-2 2-2Zm7 1.5V9h4.5L14 4.5ZM8 12c0-.6.4-1 1-1h6c.6 0 1 .4 1 1s-.4 1-1 1H9c-.6 0-1-.4-1-1Zm0 4c0-.6.4-1 1-1h6c.6 0 1 .4 1 1s-.4 1-1 1H9c-.6 0-1-.4-1-1Z"/>
      </svg>
    `;
  }

  // PC
  return `
    <svg viewBox="0 0 24 24" class="w-5 h-5" aria-hidden="true">
      <path fill="currentColor" d="M4 5.5C4 4.7 4.7 4 5.5 4h13C19.3 4 20 4.7 20 5.5v9C20 15.3 19.3 16 18.5 16H13v2h2c.5 0 1 .4 1 1s-.5 1-1 1H9c-.5 0-1-.4-1-1s.5-1 1-1h2v-2H5.5C4.7 16 4 15.3 4 14.5v-9Zm1.5.5v8.5h13V6h-13Z"/>
    </svg>
  `;
};
---

<BaseLayout title={`${game.title} - Leonardo Squarizzi`} description={game.shortDescription}>
  <Header currentPage="games" />

  <main class="pt-[72px]">
    <!-- Header / Hero -->
    <section class="py-12 md:py-16 bg-bg-primary">
      <div class="container">
        <div class="max-w-4xl mx-auto text-center flex flex-col items-center">
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-text-primary mb-4" data-animate="fade-up">
            {game.title}
          </h1>

          <p class="text-sm md:text-base text-text-muted mb-8" data-animate="fade-up" data-delay="80">
            {game.tagline}
          </p>

          <p
            class="text-base md:text-lg text-text-secondary max-w-3xl text-center"
            data-animate="fade-up"
            data-delay="120">
            {game.shortDescription}
          </p>

          <!-- Info Boxes -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6 mt-10" data-animate="fade-up" data-delay="160">
            <!-- Box Snapshot -->
            <div class="bg-bg-card border border-border-default rounded-2xl p-6">
              <p class="text-xs font-semibold text-accent-coral uppercase tracking-widest mb-4">Resumo do Projeto</p>

              <ul class="space-y-2 text-sm text-text-secondary">
                <li class="flex items-start gap-3">
                  <span class="mt-1.5 w-2 h-2 rounded-full bg-accent-coral flex-shrink-0"></span>
                  <span><span class="text-text-muted">Desenvolvedor:</span> {game.snapshop.developer}</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="mt-1.5 w-2 h-2 rounded-full bg-accent-coral flex-shrink-0"></span>
                  <span><span class="text-text-muted">Motor:</span> {game.snapshop.engine}</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="mt-1.5 w-2 h-2 rounded-full bg-accent-coral flex-shrink-0"></span>
                  <span><span class="text-text-muted">Tempo no Projeto:</span> {game.snapshop.timeOnProject}</span>
                </li>
              </ul>
            </div>

            <!-- Box Links -->
            <div class="bg-bg-card border border-border-default rounded-2xl p-6">
              <p class="text-xs font-semibold text-accent-coral uppercase tracking-widest mb-4">Links</p>

              <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm w-full">
                {
                  game.links.map((link) => (
                    <li>
                      <a
                        href={link.href}
                        target={link.external ? '_blank' : undefined}
                        rel={link.external ? 'noreferrer' : undefined}
                        class="w-full flex items-center gap-3 rounded-xl border border-border-default bg-bg-primary px-4 py-3
                             text-text-secondary hover:text-text-primary hover:border-text-primary/30 transition-colors">
                        <span class="w-9 h-9 rounded-lg bg-bg-card border border-border-default flex items-center justify-center text-accent-coral">
                          <span set:html={getLinkIcon(link.label)} />
                        </span>

                        <span class="font-medium">{link.label}</span>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Divider -->
    <div class="flex items-center gap-4 my-6" data-animate="fade-up">
      <span class="flex-1 h-px bg-border-default"></span>

      <span class="text-xs font-semibold text-text-muted uppercase tracking-widest whitespace-nowrap">
        Destaques do Projeto
      </span>

      <span class="flex-1 h-px bg-border-default"></span>
    </div>

    <!-- Highlight 01 -->
    <section class="py-12 md:py-16">
      <div class="container">
        <div class="max-w-6xl mx-auto">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
            <!-- Text -->
            <div data-animate="fade-up">
              <h3 class="text-xl md:text-2xl font-bold text-text-primary mb-0">Sistemas de Combate e Chefes</h3>
              <!-- Highlight Subtitle -->
              <p
                class="text-xs font-semibold text-accent-coral uppercase tracking-widest mb-5 text-left max-w-6xl mx-auto">
                Game Design · Design de Sistemas · IA de Inimigos
              </p>

              <div class="space-y-5 text-text-secondary text-sm md:text-base">
                <div>
                  <p class="font-semibold text-text-primary mb-1">🟥 O Problema</p>
                  <p>
                    O jogo precisava continuar simples e amigável para celular, mas ainda assim oferecer profundidade e
                    desafio crescente.
                  </p>
                  <p>
                    O gameplay central dependia totalmente de padrões de comportamento dos inimigos. A variedade e a
                    progressão precisavam surgir da lógica de movimento, e não de mecânicas complexas.
                  </p>
                </div>

                <div>
                  <p class="font-semibold text-text-primary mb-1">🟨 O Que Fiz</p>
                  <p class="mb-2">Desenhei e implementei todos os sistemas de combate e os comportamentos dos inimigos.</p>
                  <ul class="list-disc pl-5 space-y-1 text-[16px] mb-2">
                    <li>Criei a lógica de spawn de inimigos e o escalonamento de dificuldade</li>
                    <li>Desenhei mecânicas únicas de chefes com vulnerabilidades baseadas em padrões</li>
                    <li>Implementei mudanças de comportamento baseadas em vida e lógica de escalada</li>
                    <li>Montei state machines para inimigos, chefes e gatilhos de eventos</li>
                  </ul>

                  <p class="mb-2 mt-5">Cada chefe introduzia uma mecânica distinta:</p>
                  <ul class="list-disc pl-5 space-y-1 text-[16px] mb-2">
                    <li>Janelas de vulnerabilidade baseadas em tempo</li>
                    <li>Manipulação de visibilidade</li>
                    <li>Ataques de mergulho baseados em reação</li>
                    <li>Agressividade escalonada a partir de limites de HP</li>
                  </ul>
                </div>

                <div>
                  <p class="font-semibold text-text-primary mt-2 mb-2">🟩 Resultado</p>
                  <ul class="list-disc pl-5 space-y-1 text-[16px] mb-1">
                    <li>Alta variedade de gameplay usando mecânicas centrais simples</li>
                    <li>Dificuldade progressiva sem aumentar a complexidade das mecânicas</li>
                    <li>Identidade forte de chefes dentro de uma estrutura arcade minimalista</li>
                  </ul>
                </div>
              </div>
            </div>

            <!-- RIGHT SIDE -->
            <div
              class="bg-bg-card border border-border-default rounded-2xl overflow-hidden p-4"
              data-animate="fade-up"
              data-delay="80">
              <div class="flex flex-col gap-4">
                <!-- Mini Video Player -->
                <div class="w-full aspect-video rounded-xl overflow-hidden">
                  <video
                    class="w-full h-full object-cover"
                    src="/img/savetheboat/mobs.mp4"
                    controls
                    preload="metadata"
                    autoplay
                    muted
                    playsinline>
                  </video>
                </div>

                <!-- Two Vertical Images -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  {
                    highlight_1_Images.slice(0, 2).map((src, i) => (
                      <div class="relative w-full aspect-[9/16] rounded-xl overflow-hidden">
                        <img
                          src={src}
                          alt={`Investor vertical ${i + 1}`}
                          class="absolute inset-0 w-full h-full object-cover"
                          loading="lazy"
                        />
                      </div>
                    ))
                  }
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Highlight 02 -->
    <section class="py-12 md:py-16">
      <div class="container">
        <div class="max-w-6xl mx-auto">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
            <!-- Left Side: Two Videos -->
            <div class="flex flex-col gap-4">
              <!-- Video 1 -->
              <div class="w-full aspect-video rounded-xl overflow-hidden">
                <video
                  class="w-full h-full object-cover"
                  src="/img/savetheboat/shark.mp4"
                  controls
                  preload="metadata"
                  autoplay
                  muted
                  playsinline>
                </video>
              </div>

              <!-- Video 2 -->
              <div class="w-full aspect-video rounded-xl overflow-hidden">
                <video
                  class="w-full h-full object-cover"
                  src="/img/savetheboat/boss1.mp4"
                  controls
                  preload="metadata"
                  autoplay
                  muted
                  playsinline>
                </video>
              </div>
            </div>

            <!-- Text -->
            <div data-animate="fade-up">
              <h3 class="text-xl md:text-2xl font-bold text-text-primary mb-0">
                Implementação de Sistemas e Arquitetura de Gameplay
              </h3>
              <!-- Highlight Subtitle -->
              <p
                class="text-xs font-semibold text-accent-coral uppercase tracking-widest mb-5 text-left max-w-6xl mx-auto">
                Unity · State Machines · Sistemas de Eventos
              </p>

              <div class="space-y-5 text-text-secondary text-sm md:text-base">
                <div>
                  <p class="font-semibold text-text-primary mb-1">🟥 O Problema</p>
                  <p>
                    Como solo dev, todos os sistemas de gameplay precisavam ser modulares e fáceis de manter para suportar
                    iterações rápidas em um cronograma curto.
                  </p>
                </div>

                <div>
                  <p class="font-semibold text-text-primary mb-1">🟨 O Que Fiz</p>
                  <p class="mb-2">Desenhei e implementei todos os sistemas de combate e os comportamentos dos inimigos.</p>
                  <ul class="list-disc pl-5 space-y-1 text-[16px] mb-2">
                    <li>Construí sistemas de movimento e atributos do jogador</li>
                    <li>Desenhei rotinas de spawn para inimigos e power ups</li>
                    <li>Implementei state machines para comportamentos de combate</li>
                    <li>Estruturei lógica de spawn reutilizável e sistemas de gatilhos</li>
                    <li>Montei a UI e adaptei os assets visuais</li>
                  </ul>
                </div>

                <div>
                  <p class="font-semibold text-text-primary mt-2 mb-2">🟩 Resultado</p>
                  <ul class="list-disc pl-5 space-y-1 text-[16px] mb-1">
                    <li>Arquitetura de gameplay limpa, com suporte a iterações rápidas</li>
                    <li>Escalonamento de inimigos estável e controle de dificuldade de eventos</li>
                    <li>Ciclo de produção solo concluído em um mês</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Divider -->
    <div class="flex items-center gap-4 my-3" data-animate="fade-up">
      <span class="flex-1 h-px bg-border-default"></span>
      <span class="text-xs font-semibold text-text-muted uppercase tracking-widest whitespace-nowrap">
        Outras Contribuições de Design
      </span>
      <span class="flex-1 h-px bg-border-default"></span>
    </div>

    <!-- Other Highlights -->
    <section class="mt-10 mb-8">
      <div class="container">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <!-- Card 1 -->
          <div class="bg-bg-card border border-border-default rounded-2xl p-5">
            <img src="/img/savetheboat/gdd.jpg" class="w-full h-40 object-cover rounded-xl mb-4" />

            <p class="text-sm font-semibold text-text-primary mb-3">Estrutura Técnica</p>

            <ul class="space-y-2 text-sm text-text-secondary">
              <li class="flex items-start gap-3">
                <span class="mt-1.5 w-2 h-2 rounded-full bg-accent-coral flex-shrink-0"></span>
                <span>Usei ScriptableObjects para definir inimigos, eventos e parâmetros de gameplay</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-1.5 w-2 h-2 rounded-full bg-accent-coral flex-shrink-0"></span>
                <span>Apliquei padrões de herança para inimigos, itens e comportamentos de eventos</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-1.5 w-2 h-2 rounded-full bg-accent-coral flex-shrink-0"></span>
                <span>Implementei controle de direção de spawn em tempo real e lógica de spawn baseada em eventos</span>
              </li>
            </ul>
          </div>

          <!-- Card 2 -->
          <div class="bg-bg-card border border-border-default rounded-2xl p-5">
            <img src="/img/savetheboat/danger.png" class="w-full h-40 object-cover rounded-xl mb-4" />

            <p class="text-sm font-semibold text-text-primary mb-3">Ajuste de Dificuldade e Spawns</p>

            <ul class="space-y-2 text-sm text-text-secondary">
              <li class="flex items-start gap-3">
                <span class="mt-1.5 w-2 h-2 rounded-full bg-accent-coral flex-shrink-0"></span>
                <span>Sequenciei rotinas progressivas de spawn de inimigos</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-1.5 w-2 h-2 rounded-full bg-accent-coral flex-shrink-0"></span>
                <span>Controlei o ritmo com base em velocidade e quantidade</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-1.5 w-2 h-2 rounded-full bg-accent-coral flex-shrink-0"></span>
                <span>Ajustei janelas de tempo para reação</span>
              </li>
            </ul>
          </div>

          <!-- Card 3 -->
          <div class="bg-bg-card border border-border-default rounded-2xl p-5">
            <img src="/img/savetheboat/save.png" class="w-full h-40 object-cover rounded-xl mb-4" />

            <p class="text-sm font-semibold text-text-primary mb-3">Playtest e Iteração</p>

            <ul class="space-y-2 text-sm text-text-secondary">
              <li class="flex items-start gap-3">
                <span class="mt-1.5 w-2 h-2 rounded-full bg-accent-coral flex-shrink-0"></span>
                <span>Identifiquei problemas com testes e debug</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-1.5 w-2 h-2 rounded-full bg-accent-coral flex-shrink-0"></span>
                <span>Ajustei validação de spawn e controle</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-1.5 w-2 h-2 rounded-full bg-accent-coral flex-shrink-0"></span>
                <span>Fiz ajustes rápidos para iterações aceleradas</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.querySelectorAll('[data-animate="fade-up"]').forEach((el) => {
    const delay = parseInt(el.getAttribute('data-delay') || '0') / 1000;

    gsap.from(el, {
      scrollTrigger: {
        trigger: el,
        start: 'top 85%',
        toggleActions: 'play none none none',
      },
      y: 30,
      opacity: 0,
      duration: 0.6,
      delay,
      ease: 'power2.out',
    });
  });
</script>

<script>
  const setupSlider = (id, intervalMs = 45000) => {
    const slides = Array.from(document.querySelectorAll(`img[data-slide="${id}"]`));
    const prevBtn = document.querySelector(`[data-prev="${id}"]`);
    const nextBtn = document.querySelector(`[data-next="${id}"]`);
    const dots = Array.from(document.querySelectorAll(`button[data-dot="${id}"]`));
    const container = document.querySelector(`[data-slider="${id}"]`);

    if (!slides.length) return;

    let index = 0;
    let timer = null;

    const render = (newIndex) => {
      index = (newIndex + slides.length) % slides.length;

      slides.forEach((el, i) => {
        el.classList.toggle('opacity-100', i === index);
        el.classList.toggle('opacity-0', i !== index);
      });

      dots.forEach((d, i) => {
        d.classList.toggle('bg-accent-coral', i === index);
        d.classList.toggle('bg-bg-card/60', i !== index);
      });
    };

    const start = () => {
      stop();
      timer = setInterval(() => render(index + 1), intervalMs);
    };

    const stop = () => {
      if (timer) clearInterval(timer);
      timer = null;
    };

    prevBtn?.addEventListener('click', () => {
      render(index - 1);
      start();
    });
    nextBtn?.addEventListener('click', () => {
      render(index + 1);
      start();
    });

    dots.forEach((d) => {
      d.addEventListener('click', () => {
        const i = parseInt(d.getAttribute('data-index') || '0', 10);
        render(i);
        start();
      });
    });

    container?.addEventListener('mouseenter', stop);
    container?.addEventListener('mouseleave', start);

    render(0);
    start();
  };

  // auto-init: pega todos os sliders da página
  document.querySelectorAll('[data-slider]').forEach((el) => {
    const id = el.getAttribute('data-slider');
    if (id) setupSlider(id);
    //if (id) setupSlider(id, 2000);
  });
</script>