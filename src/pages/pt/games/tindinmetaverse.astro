---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Button from '../../../components/Button.astro';

const game = {
  title: 'Tindin Metaverso Educacional',
  tagline: 'Simulador de vida · Gestão · Educação · Multijogador · 2D',
  shortDescription:
    'Metaverso de educação financeira em que estudantes aprendem a cuidar do dinheiro por meio de missões, progressão e sistemas interativos.',
  snapshop: {
    developer: 'Tindin Educação',
    timeOnProject: '2 anos',
    engine: 'Phaser',
    partners: 'Faber Castell',
  },

  links: [
    { label: 'App Store', href: 'https://apps.apple.com/br/app/tindin/id1620717295', external: true },
    {
      label: 'Google Play',
      href: 'https://play.google.com/store/apps/details?id=br.com.tindin.avag&hl=pt_BR',
      external: true,
    },
    { label: 'PC', href: 'https://www.tindin.com.br/', external: true },
    {
      label: 'GDD',
      href: 'https://docs.google.com/document/d/1J4WBCva0SO6wJV8VjQ1GFpG4AqzjE_Z2p36n1natF6w/edit?usp=sharing',
      external: true,
    },
  ],

  resp_midia: '/img/tindin/Tindintrailer.mp4',

  responsibilities: [
    'Documentação e responsabilidade pelos sistemas',
    'Quests e missões (objetivos, recompensas, progressão)',
    'Design de níveis para distritos e aventuras sazonais',
    'Balanceamento de economia (custos, recompensas, investimentos)',
    'Criação de eventos do jogo',
    'Feedback de interface e design de interação',
  ],
  role: 'Game Designer / Level Designer',
};

const highlight_1_Images = [
  '/img/tindin/oldcity.png',
  '/img/tindin/district1.png',
  '/img/tindin/district2.png',
  '/img/tindin/district3.png',
  '/img/tindin/district4.png',
  '/img/tindin/district5.png',
];

const highlight_2_Images = ['/img/tindin/origami1.png', '/img/tindin/origami2.png'];

const getLinkIcon = (label: string) => {
  const key = label.toLowerCase();

  // Google Play
  if (key.includes('google') || key.includes('play')) {
    return `
      <svg viewBox="0 0 24 24" class="w-5 h-5" aria-hidden="true">
        <path fill="currentColor" d="M3.9 2.7c-.3.3-.4.8-.4 1.3v16c0 .5.1 1 .4 1.3l.1.1L13 12 4 2.6l-.1.1Zm10 9.2 2.6-2.6-9-5.2 6.4 7.8Zm3.6 0 2.5-1.5c.9-.5.9-1.3 0-1.8L17.5 7 14.8 9.6l2.7 2.3Zm-3.6.2L7.5 19.9l9-5.2-2.6-2.6Z"/>
      </svg>
    `;
  }

  // App Store (iOS)
  if (key.includes('app') || key.includes('ios') || key.includes('store')) {
    return `
      <svg viewBox="0 0 24 24" class="w-5 h-5" aria-hidden="true">
        <path fill="currentColor" d="M16.4 13.2l-2.9-5.1c-.2-.4-.7-.6-1.1-.4-.4.2-.6.7-.4 1.1l2.9 5.1h1.5ZM10.9 13.2L8 8.1c-.2-.4-.7-.6-1.1-.4-.4.2-.6.7-.4 1.1l2.8 4.9.1.1h1.5Zm8.2 5.6H4.9c-.5 0-.9.4-.9.9s.4.9.9.9h14.2c.5 0 .9-.4.9-.9s-.4-.9-.9-.9ZM13.9 4.1c.6-.7 1-1.6.9-2.6-1 .1-1.9.6-2.5 1.3-.6.7-1 1.6-.9 2.6 1-.1 1.9-.6 2.5-1.3Z"/>
        <path fill="currentColor" d="M20 16.2c-1.5 0-2.3-.7-3.1-1.4-.7-.6-1.3-1.1-2.4-1.1-1.1 0-1.7.5-2.4 1.1-.8.7-1.6 1.4-3.1 1.4s-2.3-.7-3.1-1.4c-.3-.3-.6-.5-.9-.7-.4-.2-.6-.7-.4-1.1.2-.4.7-.6 1.1-.4.5.3.9.6 1.3.9.7.6 1.3 1.1 2 .9.8 0 1.3-.4 2-1 .8-.7 1.8-1.6 3.5-1.6s2.7.9 3.5 1.6c.7.6 1.2 1 2 1 .2 0 .4 0 .6-.1.5-.1.9.2 1 .6.1.5-.2.9-.6 1-.4.2-.8.3-1.2.3Z"/>
      </svg>
    `;
  }

  // GDD (document)
  if (key.includes('gdd')) {
    return `
      <svg viewBox="0 0 24 24" class="w-5 h-5" aria-hidden="true">
        <path fill="currentColor" d="M7 3h7l5 5v13c0 1.1-.9 2-2 2H7c-1.1 0-2-.9-2-2V5c0-1.1.9-2 2-2Zm7 1.5V9h4.5L14 4.5ZM8 12c0-.6.4-1 1-1h6c.6 0 1 .4 1 1s-.4 1-1 1H9c-.6 0-1-.4-1-1Zm0 4c0-.6.4-1 1-1h6c.6 0 1 .4 1 1s-.4 1-1 1H9c-.6 0-1-.4-1-1Z"/>
      </svg>
    `;
  }

  // PC
  return `
    <svg viewBox="0 0 24 24" class="w-5 h-5" aria-hidden="true">
      <path fill="currentColor" d="M4 5.5C4 4.7 4.7 4 5.5 4h13C19.3 4 20 4.7 20 5.5v9C20 15.3 19.3 16 18.5 16H13v2h2c.5 0 1 .4 1 1s-.5 1-1 1H9c-.5 0-1-.4-1-1s.5-1 1-1h2v-2H5.5C4.7 16 4 15.3 4 14.5v-9Zm1.5.5v8.5h13V6h-13Z"/>
    </svg>
  `;
};
---

<BaseLayout title={`${game.title} - Leonardo Squarizzi`} description={game.shortDescription}>
  <Header currentPage="games" />

  <main class="pt-[72px]">
    <!-- Header / Hero -->
    <section class="py-12 md:py-16 bg-bg-primary">
      <div class="container">
        <div class="max-w-4xl mx-auto text-center flex flex-col items-center">
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-text-primary mb-4" data-animate="fade-up">
            {game.title}
          </h1>

          <p class="text-sm md:text-base text-text-muted mb-8" data-animate="fade-up" data-delay="80">
            {game.tagline}
          </p>

          <p
            class="text-base md:text-lg text-text-secondary max-w-3xl text-center"
            data-animate="fade-up"
            data-delay="120">
            {game.shortDescription}
          </p>

          <!-- Info Boxes -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6 mt-10" data-animate="fade-up" data-delay="160">
            <!-- Box Snapshot -->
            <div class="bg-bg-card border border-border-default rounded-2xl p-6">
              <p class="text-xs font-semibold text-accent-coral uppercase tracking-widest mb-4">Resumo do projeto</p>

              <ul class="space-y-2 text-sm text-text-secondary">
                <li class="flex items-start gap-3">
                  <span class="mt-1.5 w-2 h-2 rounded-full bg-accent-coral flex-shrink-0"></span>
                  <span><span class="text-text-muted">Desenvolvedor:</span> {game.snapshop.developer}</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="mt-1.5 w-2 h-2 rounded-full bg-accent-coral flex-shrink-0"></span>
                  <span><span class="text-text-muted">Engine:</span> {game.snapshop.engine}</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="mt-1.5 w-2 h-2 rounded-full bg-accent-coral flex-shrink-0"></span>
                  <span><span class="text-text-muted">Tempo no projeto:</span> {game.snapshop.timeOnProject}</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="mt-1.5 w-2 h-2 rounded-full bg-accent-coral flex-shrink-0"></span>
                  <span><span class="text-text-muted">Parceiros:</span> {game.snapshop.partners}</span>
                </li>
              </ul>
            </div>

            <!-- Box Links -->
            <div class="bg-bg-card border border-border-default rounded-2xl p-6">
              <p class="text-xs font-semibold text-accent-coral uppercase tracking-widest mb-4">Links</p>

              <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm w-full">
                {
                  game.links.map((link) => (
                    <li>
                      <a
                        href={link.href}
                        target={link.external ? '_blank' : undefined}
                        rel={link.external ? 'noreferrer' : undefined}
                        class="w-full flex items-center gap-3 rounded-xl border border-border-default bg-bg-primary px-4 py-3
                             text-text-secondary hover:text-text-primary hover:border-text-primary/30 transition-colors">
                        <span class="w-9 h-9 rounded-lg bg-bg-card border border-border-default flex items-center justify-center text-accent-coral">
                          <span set:html={getLinkIcon(link.label)} />
                        </span>

                        <span class="font-medium">{link.label}</span>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Responsibilities -->
    <section class="py-12 md:py-16 bg-bg-secondary">
      <div class="container">
        <div class="max-w-5xl mx-auto">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
            <!-- Right: video -->
            <div
              class="bg-bg-card border border-border-default rounded-2xl overflow-hidden"
              data-animate="fade-up"
              data-delay="120">
              <video
                class="w-full h-full object-cover"
                src={game.resp_midia}
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
                controls>
              </video>
            </div>
            <!-- Right: text -->
            <div>
              <h2 class="text-2xl md:text-3xl font-bold text-text-primary mb-2" data-animate="fade-up">
                Meu papel e contribuições
              </h2>

              <p
                class="text-xs font-semibold text-accent-coral uppercase tracking-widest mb-6"
                data-animate="fade-up"
                data-delay="40">
                {game.role}
              </p>
              <ul class="space-y-3 text-text-secondary" data-animate="fade-up" data-delay="80">
                {
                  game.responsibilities.map((item) => (
                    <li class="flex items-start gap-3">
                      <span class="mt-2 w-2 h-2 rounded-full bg-accent-coral flex-shrink-0" />
                      <span>{item}</span>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Divider -->
    <div class="flex items-center gap-4 my-12" data-animate="fade-up">
      <span class="flex-1 h-px bg-border-default"></span>

      <span class="text-xs font-semibold text-text-muted uppercase tracking-widest whitespace-nowrap">
        Destaques do projeto
      </span>

      <span class="flex-1 h-px bg-border-default"></span>
    </div>

    <!-- Highlight 01 -->
    <section class="py-12 md:py-16">
      <div class="container">
        <div class="max-w-6xl mx-auto">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
            <!-- Text -->
            <div data-animate="fade-up">
              <h3 class="text-xl md:text-2xl font-bold text-text-primary mb-0">Level Design do Metaverso</h3>
              <p
                class="text-xs font-semibold text-accent-coral uppercase tracking-widest mb-5 text-left max-w-6xl mx-auto">
                Level Desgin · Progressão · UX
              </p>

              <div class="space-y-5 text-text-secondary text-sm md:text-base">
                <div>
                  <p class="font-semibold text-text-primary mb-1">🟥 O problema</p>
                  <p>
                    O layout original da cidade prejudicava performance e fluxo do jogador, com áreas de desafio pouco
                    claras e visual desinteressante.
                  </p>
                  <span class="text-[13px] font-medium text-text-muted/80 tracking-wide">[Imagem 1]</span>
                </div>

                <div>
                  <p class="font-semibold text-text-primary mb-1">🟨 O que eu fiz</p>
                  <ul class="list-disc pl-5 space-y-1 text-[16px] mb-2">
                    <li>Reestruturei a cidade em distritos bem definidos</li>
                    <li>Criei identidade visual com padronização por cores</li>
                    <li>Separei por conteúdos (Educação, Saúde, etc)</li>
                    <li>Implementei um sistema de viagem rápida para melhorar navegação.</li>
                  </ul>
                </div>

                <div>
                  <p class="font-semibold text-text-primary mb-1">🟩 Impacto</p>
                  <p>
                    A nova estrutura melhorou imersão, escalabilidade e engajamento, e virou a base para futuras
                    atualizações e eventos.
                  </p>
                  <p>
                    Além disso facilitou o entendimento dos usuários e interatividade com o cenário.
                    <span class="text-[13px] font-medium text-text-muted/80 tracking-wide">[Imagens 2 a 6]</span>
                  </p>
                </div>
              </div>
            </div>

            <!-- Slider -->
            <div
              class="bg-bg-card border border-border-default rounded-2xl overflow-hidden relative"
              data-slider="city-1"
              data-animate="fade-up"
              data-delay="80">
              <div class="relative w-full aspect-video">
                {
                  highlight_1_Images.map((src, i) => (
                    <img
                      src={src}
                      alt={`Reestruturação da cidade do metaverso ${i + 1}`}
                      class={`absolute inset-0 w-full h-full object-cover transition-opacity duration-500 ${i === 0 ? 'opacity-100' : 'opacity-0'}`}
                      data-slide="city-1"
                    />
                  ))
                }
              </div>

              <!-- Controls -->
              <button
                type="button"
                class="absolute left-3 top-1/2 -translate-y-1/2 w-10 h-10 rounded-xl bg-bg-card/80 border border-border-default text-text-primary flex items-center justify-center hover:bg-bg-card transition-colors"
                aria-label="Imagem anterior"
                data-prev="city-1">
                ‹
              </button>

              <button
                type="button"
                class="absolute right-3 top-1/2 -translate-y-1/2 w-10 h-10 rounded-xl bg-bg-card/80 border border-border-default text-text-primary flex items-center justify-center hover:bg-bg-card transition-colors"
                aria-label="Próxima imagem"
                data-next="city-1">
                ›
              </button>

              <!-- Dots -->
              <div class="absolute bottom-3 left-1/2 -translate-x-1/2 flex gap-2">
                {
                  highlight_1_Images.map((_, i) => (
                    <button
                      type="button"
                      class={`w-2.5 h-2.5 rounded-full border border-border-default ${i === 0 ? 'bg-accent-coral' : 'bg-bg-card/60'} transition-colors`}
                      aria-label={`Ir para a imagem ${i + 1}`}
                      data-dot="city-1"
                      data-index={i}
                    />
                  ))
                }
              </div>
            </div>
          </div>
        </div>

        <!-- Highlight 02 -->
        <section class="py-12 md:py-16">
          <div class="container">
            <div class="max-w-6xl mx-auto">
              <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
                <!-- LEFT SIDE -->
                <div class="flex flex-col gap-6">
                  <!-- Slider -->
                  <div
                    class="bg-bg-card border border-border-default rounded-2xl overflow-hidden relative"
                    data-slider="city-2">
                    <div class="relative w-full aspect-video">
                      {
                        highlight_2_Images.map((src, i) => (
                          <img
                            src={src}
                            alt={`Destaque 2 ${i + 1}`}
                            class={`absolute inset-0 w-full h-full object-cover transition-opacity duration-500 ${
                              i === 0 ? 'opacity-100' : 'opacity-0'
                            }`}
                            data-slide="city-2"
                          />
                        ))
                      }
                    </div>

                    <!-- Controls -->
                    <button
                      type="button"
                      class="absolute left-3 top-1/2 -translate-y-1/2 w-10 h-10 rounded-xl bg-bg-card/80 border border-border-default text-text-primary flex items-center justify-center hover:bg-bg-card transition-colors"
                      aria-label="Imagem anterior"
                      data-prev="city-2">
                      ‹
                    </button>

                    <button
                      type="button"
                      class="absolute right-3 top-1/2 -translate-y-1/2 w-10 h-10 rounded-xl bg-bg-card/80 border border-border-default text-text-primary flex items-center justify-center hover:bg-bg-card transition-colors"
                      aria-label="Próxima imagem"
                      data-next="city-2">
                      ›
                    </button>

                    <!-- Dots -->
                    <div class="absolute bottom-3 left-1/2 -translate-x-1/2 flex gap-2">
                      {
                        highlight_2_Images.map((_, i) => (
                          <button
                            type="button"
                            class={`w-2.5 h-2.5 rounded-full border border-border-default ${
                              i === 0 ? 'bg-accent-coral' : 'bg-bg-card/60'
                            }`}
                            aria-label={`Ir para a imagem ${i + 1}`}
                            data-dot="city-2"
                            data-index={i}
                          />
                        ))
                      }
                    </div>
                  </div>

                  <!-- Static Image -->
                  <div class="bg-bg-card border border-border-default rounded-2xl overflow-hidden">
                    <img
                      src="/img/tindin/origamifull.png"
                      alt="Visão geral da Ilha do Origami"
                      class="w-full object-cover"
                    />
                  </div>
                </div>

                <!-- Text (Right) -->
                <div data-animate="fade-up">
                  <h3 class="text-xl md:text-2xl font-bold text-text-primary mb-0">
                    Aventuras sazonais: Ilha do Origami
                  </h3>

                  <p class="text-xs font-semibold text-accent-coral uppercase tracking-widest mb-5 text-left">
                    Game design · Level Desgin · Eventos · Quest Design
                  </p>

                  <div class="space-y-5 text-text-secondary text-sm md:text-base">
                    <div>
                      <p class="font-semibold text-text-primary mb-1">🟥 O problema</p>
                      <p>
                        O metaverso dependia de vários mapas desconectados, conteúdo repetitivo e muito voltado para
                        escola.
                      </p>
                      <p>Isso gerava desinteresse, pouco engajamento ao longo do tempo e baixa avaliação.</p>
                    </div>

                    <div>
                      <p class="font-semibold text-text-primary mb-1 mt-2">🟨 O que eu fiz</p>

                      <p class="mb-4">
                        Criei um sistema de aventuras especiais, com narrativas temáticas e recompensas por tempo
                        limitado, independente do metaverso principal.
                      </p>

                      <p class="mb-4">
                        A Ilha do Origami foi o primeiro mapa construído como uma aventura completa, sem telas de
                        carregamento entre diferentes ilhas.
                      </p>

                      <p class="mb-2">Para chegar nisso, eu:</p>

                      <ul class="list-disc pl-5 space-y-1 text-[16px] mb-2">
                        <li>Criei uma água usando a engine, sem necessidade de sprites animadas</li>
                        <li>Criei um sistema de transporte sem loading conectando ilhas distantes</li>
                        <li>Mudanças no cenário conforme a progressão das quests</li>
                        <li>Implementei um sistema de recompensas com itens exclusivos, temáticos e por tempo limitado </li>
                      </ul>
                    </div>

                    <div>
                      <p class="font-semibold text-text-primary mb-1 mt-2">
                        🟩 Impacto (baseado no feedback dos jogadores)
                      </p>
                      <ul class="list-disc pl-5 space-y-1 text-[16px] mb-1">
                        <li>O evento aumentou bastante o engajamento</li>
                        <li>Sem telas de carregamento, o ritmo e a imersão melhoraram</li>
                        <li>Recompensas limitadas criaram senso de urgência e motivação</li>
                        <li>Origami virou caso de sucesso para outras aventuras</li>
                      </ul>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- Divider -->
        <div class="flex items-center gap-4 my-3" data-animate="fade-up">
          <span class="flex-1 h-px bg-border-default"></span>
          <span class="text-xs font-semibold text-text-muted uppercase tracking-widest whitespace-nowrap">
            Outras contribuições
          </span>
          <span class="flex-1 h-px bg-border-default"></span>
        </div>
      </div>

      <!-- Other Highlights -->
      <section class="mt-10">
        <div class="container">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- Card 1 -->
            <div class="bg-bg-card border border-border-default rounded-2xl p-5">
              <img src="/img/tindin/itensmap.avif" class="w-full h-40 object-cover rounded-xl mb-4" />

              <p class="text-sm font-semibold text-text-primary mb-3">Banco de Dados de Assets [MongoDB]</p>

              <ul class="space-y-2 text-sm text-text-secondary">
                <li class="flex items-start gap-3">
                  <span class="mt-1.5 w-2 h-2 rounded-full bg-accent-coral flex-shrink-0"></span>
                  <span>Criação de nome, categoria e valores</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="mt-1.5 w-2 h-2 rounded-full bg-accent-coral flex-shrink-0"></span>
                  <span>Configuração de assets interativos</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="mt-1.5 w-2 h-2 rounded-full bg-accent-coral flex-shrink-0"></span>
                  <span>Sistema de tags para eventos, progresso e economia</span>
                </li>
              </ul>
            </div>

            <!-- Card 2 -->
            <div class="bg-bg-card border border-border-default rounded-2xl p-5">
              <img src="/img/tindin/buymechanics.webp" class="w-full h-40 object-cover rounded-xl mb-4" />

              <p class="text-sm font-semibold text-text-primary mb-3">Planejamento do Coreloop do Jogo</p>

              <ul class="space-y-2 text-sm text-text-secondary">
                <li class="flex items-start gap-3">
                  <span class="mt-1.5 w-2 h-2 rounded-full bg-accent-coral flex-shrink-0"></span>
                  <span>Estruturação de fluxos narrativos principais</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="mt-1.5 w-2 h-2 rounded-full bg-accent-coral flex-shrink-0"></span>
                  <span>Relação entre decisões e condições dos jogadores</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="mt-1.5 w-2 h-2 rounded-full bg-accent-coral flex-shrink-0"></span>
                  <span>Integração de escolhas, estados do sistema e progressão</span>
                </li>
              </ul>
            </div>

            <!-- Card 3 -->
            <div class="bg-bg-card border border-border-default rounded-2xl p-5">
              <img src="/img/tindin/fluxgram.avif" class="w-full h-40 object-cover rounded-xl mb-4" />

              <p class="text-sm font-semibold text-text-primary mb-3">Documentação dos Projetos</p>

              <ul class="space-y-2 text-sm text-text-secondary">
                <li class="flex items-start gap-3">
                  <span class="mt-1.5 w-2 h-2 rounded-full bg-accent-coral flex-shrink-0"></span>
                  <span>GDDs estruturados para uso do time</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="mt-1.5 w-2 h-2 rounded-full bg-accent-coral flex-shrink-0"></span>
                  <span>Modelos reutilizáveis para narrativa, fluxos de ações e design de missões</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="mt-1.5 w-2 h-2 rounded-full bg-accent-coral flex-shrink-0"></span>
                  <span>Atualizações de documentação junto com as iterações e desenvolvimento</span>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </section>
    </section>
    <Footer />

    <script>
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      document.querySelectorAll('[data-animate="fade-up"]').forEach((el) => {
        const delay = parseInt(el.getAttribute('data-delay') || '0') / 1000;

        gsap.from(el, {
          scrollTrigger: {
            trigger: el,
            start: 'top 85%',
            toggleActions: 'play none none none',
          },
          y: 30,
          opacity: 0,
          duration: 0.6,
          delay,
          ease: 'power2.out',
        });
      });
    </script>

    <script>
      const setupSlider = (id, intervalMs = 45000) => {
        const slides = Array.from(document.querySelectorAll(`img[data-slide="${id}"]`));
        const prevBtn = document.querySelector(`[data-prev="${id}"]`);
        const nextBtn = document.querySelector(`[data-next="${id}"]`);
        const dots = Array.from(document.querySelectorAll(`button[data-dot="${id}"]`));
        const container = document.querySelector(`[data-slider="${id}"]`);

        if (!slides.length) return;

        let index = 0;
        let timer = null;

        const render = (newIndex) => {
          index = (newIndex + slides.length) % slides.length;

          slides.forEach((el, i) => {
            el.classList.toggle('opacity-100', i === index);
            el.classList.toggle('opacity-0', i !== index);
          });

          dots.forEach((d, i) => {
            d.classList.toggle('bg-accent-coral', i === index);
            d.classList.toggle('bg-bg-card/60', i !== index);
          });
        };

        const start = () => {
          stop();
          timer = setInterval(() => render(index + 1), intervalMs);
        };

        const stop = () => {
          if (timer) clearInterval(timer);
          timer = null;
        };

        prevBtn?.addEventListener('click', () => {
          render(index - 1);
          start();
        });
        nextBtn?.addEventListener('click', () => {
          render(index + 1);
          start();
        });

        dots.forEach((d) => {
          d.addEventListener('click', () => {
            const i = parseInt(d.getAttribute('data-index') || '0', 10);
            render(i);
            start();
          });
        });

        container?.addEventListener('mouseenter', stop);
        container?.addEventListener('mouseleave', start);

        render(0);
        start();
      };

      // auto-init: pega todos os sliders da página
      document.querySelectorAll('[data-slider]').forEach((el) => {
        const id = el.getAttribute('data-slider');
        if (id) setupSlider(id);
        //if (id) setupSlider(id, 2000);
      });
    </script>
  </main></BaseLayout
