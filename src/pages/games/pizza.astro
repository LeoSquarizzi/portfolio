---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Button from '../../components/Button.astro';

const game = {
  title: 'Everything Ends in Pizza',
  tagline: 'Infinity Runner · Arcade · Casual · 2D · Mobile',
  shortDescription:
    'For teenagers who love games and pizza, Everything Ends in Pizza is a mobile game that transforms the cycle of a pizzeria in fantasy.',
  snapshop: {
    developer: 'AGL Dev Team',
    timeOnProject: '4 months',
    engine: 'Unity',
  },

  links: [
    {
      label: 'GDD',
      href: 'https://drive.google.com/file/d/1LaYLtVdz8IU2yy0Lo3XcoLVdNmhvoXXu/view?usp=sharing',
      external: true,
    },
    {
      label: 'Dev Log Process',
      href: 'https://drive.google.com/file/d/1QvlQk06prNbdbAKSkNH-P4kFUSe9qx4V/view?usp=sharing',
      external: true,
    },
    {
      label: 'Game Presentation',
      href: 'https://drive.google.com/file/d/1CgbCPZcEXfBLDLt9vQTq-viHX-i0RZc0/view?usp=sharing',
      external: true,
    },
    {
      label: 'Game Media',
      href: 'https://drive.google.com/drive/folders/1iS1L7pVgeNtMjKHyvX8_vN6baUn7m0MQ?usp=sharing',
      external: true,
    },
    {
      label: 'PUC Presentation',
      href: 'https://drive.google.com/file/d/1FjU8Eha365OtEmDr-zyZoDwW1Hj64dFt/view?usp=sharing',
      external: true,
    },
    {
      label: 'Trello',
      href: 'https://trello.com/b/eJoR2eVL/everything-ends-in-pizza',
      external: true,
    },
  ],

  resp_midia: 'uPnWBab_ywM',

  responsibilities: [
    'Designed mechanics for all minigames',
    'Implemented gameplay systems in Unity',
    'Balanced difficulty and score progression',
    'Managed game assets and integration',
    'Contributed to documentation and task tracking',
  ],

  role: 'Game Designer · Tech Design · Game Developer',
};

const highlight_1_Images = ['/img/pizza/minigame2.png', '/img/pizza/minigame3.png', '/img/pizza/minigame.png'];

const highlight_2_Images = ['/img/literama/origami1.png', '/img/literama/origami2.png'];

const getLinkIcon = (label: string) => {
  const key = label.toLowerCase();

  // Google Play
  if (key.includes('google') || key.includes('play')) {
    return `
      <svg viewBox="0 0 24 24" class="w-5 h-5" aria-hidden="true">
        <path fill="currentColor" d="M3.9 2.7c-.3.3-.4.8-.4 1.3v16c0 .5.1 1 .4 1.3l.1.1L13 12 4 2.6l-.1.1Zm10 9.2 2.6-2.6-9-5.2 6.4 7.8Zm3.6 0 2.5-1.5c.9-.5.9-1.3 0-1.8L17.5 7 14.8 9.6l2.7 2.3Zm-3.6.2L7.5 19.9l9-5.2-2.6-2.6Z"/>
      </svg>
    `;
  }

  // GDD (document)
  if (key.includes('gdd') || key.includes('dev log process')) {
    return `
      <svg viewBox="0 0 24 24" class="w-5 h-5" aria-hidden="true">
        <path fill="currentColor" d="M7 3h7l5 5v13c0 1.1-.9 2-2 2H7c-1.1 0-2-.9-2-2V5c0-1.1.9-2 2-2Zm7 1.5V9h4.5L14 4.5ZM8 12c0-.6.4-1 1-1h6c.6 0 1 .4 1 1s-.4 1-1 1H9c-.6 0-1-.4-1-1Zm0 4c0-.6.4-1 1-1h6c.6 0 1 .4 1 1s-.4 1-1 1H9c-.6 0-1-.4-1-1Z"/>
      </svg>
    `;
  }

  // PC
  return `
    <svg viewBox="0 0 24 24" class="w-5 h-5" aria-hidden="true">
      <path fill="currentColor" d="M4 5.5C4 4.7 4.7 4 5.5 4h13C19.3 4 20 4.7 20 5.5v9C20 15.3 19.3 16 18.5 16H13v2h2c.5 0 1 .4 1 1s-.5 1-1 1H9c-.5 0-1-.4-1-1s.5-1 1-1h2v-2H5.5C4.7 16 4 15.3 4 14.5v-9Zm1.5.5v8.5h13V6h-13Z"/>
    </svg>
  `;
};
---

<BaseLayout title={`${game.title} - Leonardo Squarizzi`} description={game.shortDescription}>
  <Header currentPage="games" />

  <main class="pt-[72px]">
    <!-- Header / Hero -->
    <section class="py-12 md:py-16 bg-bg-primary">
      <div class="container">
        <div class="max-w-4xl mx-auto text-center flex flex-col items-center">
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-text-primary mb-4" data-animate="fade-up">
            {game.title}
          </h1>

          <p class="text-sm md:text-base text-text-muted mb-8" data-animate="fade-up" data-delay="80">
            {game.tagline}
          </p>

          <p
            class="text-base md:text-lg text-text-secondary max-w-3xl text-center"
            data-animate="fade-up"
            data-delay="120">
            {game.shortDescription}
          </p>

          <!-- Info Boxes -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-2 md:gap-6 mt-10" data-animate="fade-up" data-delay="160">
            <!-- Box Snapshot -->
            <div class="bg-bg-card border border-border-default rounded-2xl p-6">
              <p class="text-xs font-semibold text-accent-coral uppercase tracking-widest mb-4">Project Snapshot</p>

              <ul class="space-y-2 text-sm text-text-secondary">
                <li class="flex items-start gap-3">
                  <span class="mt-1.5 w-2 h-2 rounded-full bg-accent-coral flex-shrink-0"></span>
                  <span><span class="text-text-muted">Developer:</span> {game.snapshop.developer}</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="mt-1.5 w-2 h-2 rounded-full bg-accent-coral flex-shrink-0"></span>
                  <span><span class="text-text-muted">Engine:</span> {game.snapshop.engine}</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="mt-1.5 w-2 h-2 rounded-full bg-accent-coral flex-shrink-0"></span>
                  <span><span class="text-text-muted">Time on project:</span> {game.snapshop.timeOnProject}</span>
                </li>
              </ul>
            </div>

            <!-- Box Links (compact) -->
            <div class="bg-bg-card border border-border-default rounded-2xl p-5">
              <p class="text-[11px] font-semibold text-accent-coral uppercase tracking-widest mb-3">Links</p>

              <ul class="grid grid-cols-2 gap-2 text-xs w-full">
                {
                  game.links.map((link) => (
                    <li>
                      <a
                        href={link.href}
                        target={link.external ? '_blank' : undefined}
                        rel={link.external ? 'noreferrer' : undefined}
                        class="w-full flex items-center gap-2 rounded-lg border border-border-default bg-bg-primary
                   px-3 py-2 text-text-secondary hover:text-text-primary
                   hover:border-text-primary/30 transition-colors">
                        <span
                          class="w-7 h-7 shrink-0 rounded-md bg-bg-card border border-border-default
                         flex items-center justify-center text-accent-coral
                         [&_svg]:w-4 [&_svg]:h-4">
                          <span set:html={getLinkIcon(link.label)} />
                        </span>

                        <span class="font-medium truncate">{link.label}</span>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Responsibilities -->
    <section class="py-6 md:py-16 bg-bg-secondary">
      <div class="container">
        <div class="max-w-5xl mx-auto">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
            <!-- Right: YouTube video -->
            <div
              class="bg-bg-card border border-border-default rounded-2xl overflow-hidden aspect-video"
              data-animate="fade-up"
              data-delay="120">
              <iframe
                class="w-full h-full"
                src={`https://www.youtube.com/embed/${game.resp_midia}?rel=0&modestbranding=1`}
                title="YouTube video player"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen>
              </iframe>
            </div>
            <!-- Right: text -->
            <div>
              <h2 class="text-2xl md:text-3xl font-bold text-text-primary mb-2" data-animate="fade-up">
                My role & contributions
              </h2>

              <p
                class="text-xs font-semibold text-accent-coral uppercase tracking-widest mb-6"
                data-animate="fade-up"
                data-delay="40">
                {game.role}
              </p>
              <ul class="space-y-3 text-text-secondary" data-animate="fade-up" data-delay="80">
                {
                  game.responsibilities.map((item) => (
                    <li class="flex items-start gap-3">
                      <span class="mt-2 w-2 h-2 rounded-full bg-accent-coral flex-shrink-0" />
                      <span>{item}</span>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Divider -->
    <div class="flex items-center gap-4 my-6" data-animate="fade-up">
      <span class="flex-1 h-px bg-border-default"></span>

      <span class="text-xs font-semibold text-text-muted uppercase tracking-widest whitespace-nowrap">
        Project Highlights
      </span>

      <span class="flex-1 h-px bg-border-default"></span>
    </div>

    <!-- Highlight 01 -->
    <section class="py-12 md:py-16">
      <div class="container">
        <div class="max-w-6xl mx-auto">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
            <!-- Slider (Left) -->
            <div
              class="bg-bg-card border border-border-default rounded-2xl overflow-hidden relative"
              data-slider="city-1"
              data-animate="fade-up"
              data-delay="80">
              <div class="relative w-full flex justify-center">
                <div class="relative w-full max-w-[320px] aspect-[9/16] max-h-[500px] overflow-hidden">
                  {
                    highlight_1_Images.map((src, i) => (
                      <img
                        src={src}
                        alt={`Highlights ${i + 1}`}
                        class={`absolute inset-0 w-full h-full object-contain transition-opacity duration-500 ${
                          i === 0 ? 'opacity-100' : 'opacity-0'
                        }`}
                        data-slide="city-1"
                      />
                    ))
                  }
                </div>
              </div>

              <!-- Controls -->
              <button
                type="button"
                class="absolute left-3 top-1/2 -translate-y-1/2 w-10 h-10 rounded-xl bg-bg-card/80 border border-border-default text-text-primary flex items-center justify-center hover:bg-bg-card transition-colors"
                aria-label="Previous image"
                data-prev="city-1">
                ‹
              </button>

              <button
                type="button"
                class="absolute right-3 top-1/2 -translate-y-1/2 w-10 h-10 rounded-xl bg-bg-card/80 border border-border-default text-text-primary flex items-center justify-center hover:bg-bg-card transition-colors"
                aria-label="Next image"
                data-next="city-1">
                ›
              </button>

              <!-- Dots -->
              <div class="absolute bottom-3 left-1/2 -translate-x-1/2 flex gap-2">
                {
                  highlight_1_Images.map((_, i) => (
                    <button
                      type="button"
                      class={`w-2.5 h-2.5 rounded-full border border-border-default ${
                        i === 0 ? 'bg-accent-coral' : 'bg-bg-card/60'
                      } transition-colors`}
                      aria-label={`Go to image ${i + 1}`}
                      data-dot="city-1"
                      data-index={i}
                    />
                  ))
                }
              </div>
            </div>

            <!-- Text (Right) -->
            <div data-animate="fade-up" class="text-text-secondary font-normal">
              <h3 class="text-xl md:text-2xl font-bold text-text-primary mb-0">Multi Minigame Systems Design</h3>

              <p class="text-xs font-semibold text-accent-coral uppercase tracking-widest mb-5">
                Game Designer · Systems Designer · Unity Developer
              </p>

              <div class="space-y-5 text-text-secondary text-sm md:text-base">
                <div>
                  <p class="font-semibold text-text-primary mb-1">🟥 The problem</p>
                  <p>
                    The game required multiple minigames with different mechanics while maintaining coherence and
                    progression balance.
                  </p>
                </div>

                <div>
                  <p class="font-semibold text-text-primary mb-1 mt-2">🟨 What I did</p>
                  <ul class="list-disc pl-5 space-y-1 text-[16px] mb-1">
                    <li>Designed unique mechanics for ingredient sorting, assembling, baking and slicing</li>
                    <li>Structured each minigame around simple input loops</li>
                    <li>Balanced difficulty progression across different skill types</li>
                    <li>Ensured mechanical clarity despite rapid gameplay pacing</li>
                  </ul>
                </div>

                <div>
                  <p class="font-semibold text-text-primary mb-1 mt-2">🟩 Result</p>
                  <ul class="list-disc pl-5 space-y-1 text-[16px] mb-1">
                    <li>Delivered variety without mechanical inconsistency</li>
                    <li>Increased replayability and leaderboards</li>
                    <li>Created modular systems that could be expanded with new minigames</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Highlight 02 -->
    <section class="py-12 md:py-16">
      <div class="container">
        <div class="max-w-6xl mx-auto">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
            <!-- Text -->
            <div data-animate="fade-up" class="text-text-secondary font-normal">
              <h3 class="text-xl md:text-2xl font-bold text-text-primary mb-0">Endless Runner Core Loop</h3>

              <p class="text-xs font-semibold text-accent-coral uppercase tracking-widest mb-5">
                Gameplay Designer · Balancing · Unity Developer
              </p>

              <div class="space-y-5 text-text-secondary text-sm md:text-base">
                <div>
                  <p class="font-semibold text-text-primary mb-1">🟥 The problem</p>
                  <p>The main mode needed to sustain engagement through a simple but scalable loop.</p>
                </div>

                <div>
                  <p class="font-semibold text-text-primary mb-1 mt-2">🟨 What I did</p>
                  <ul class="list-disc pl-5 space-y-1 text-[16px] mb-1">
                    <li>Designed obstacle and opponent patterns</li>
                    <li>Tuned pacing and difficulty ramp</li>
                    <li>Integrated global leaderboard competition</li>
                    <li>Balanced risk vs reward in scoring opportunities</li>
                  </ul>
                </div>

                <div>
                  <p class="font-semibold text-text-primary mb-1 mt-2">🟩 Result</p>
                  <ul class="list-disc pl-5 space-y-1 text-[16px] mb-1">
                    <li>Created a competitive score loop</li>
                    <li>Encouraged replay through leaderboard progression</li>
                    <li>Established a clear contrast between arcade mode and minigames</li>
                  </ul>
                </div>
              </div>
            </div>
            <!-- Right SIDE -->
            <div class="bg-bg-card border border-border-default rounded-2xl overflow-hidden">
              <img src="/img/pizza/runner.png" alt="Runner Pizza" class="w-full object-cover" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Divider -->
    <div class="flex items-center gap-4 my-3" data-animate="fade-up">
      <span class="flex-1 h-px bg-border-default"></span>
      <span class="text-xs font-semibold text-text-muted uppercase tracking-widest whitespace-nowrap">Other Highlights</span>
      <span class="flex-1 h-px bg-border-default"></span>
    </div>

    <!-- Other Highlights -->
    <section class="mt-8 mb-8">
      <div class="container">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <!-- Card 1 -->
          <div class="bg-bg-card border border-border-default rounded-2xl p-5">
            <img src="/img/pizza/menu.png" class="w-full h-40 object-cover rounded-xl mb-4" />

            <p class="text-sm font-semibold text-text-primary mb-3">Gameplay Balancing & Curve</p>

            <ul class="space-y-2 text-sm text-text-secondary">
              <li class="flex items-start gap-3">
                <span class="mt-1.5 w-2 h-2 rounded-full bg-accent-coral flex-shrink-0"></span>
                <span>Balanced pacing across runner and minigames</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-1.5 w-2 h-2 rounded-full bg-accent-coral flex-shrink-0"></span>
                <span>Tuned scoring systems for competition</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-1.5 w-2 h-2 rounded-full bg-accent-coral flex-shrink-0"></span>
                <span>Adjusted challenge to teenage audience profile</span>
              </li>
            </ul>
          </div>

          <!-- Card 2 -->
          <div class="bg-bg-card border border-border-default rounded-2xl p-5">
            <img src="/img/pizza/menu2.png" class="w-full h-40 object-cover rounded-xl mb-4" />

            <p class="text-sm font-semibold text-text-primary mb-3">Asset & Production Management</p>

            <ul class="space-y-2 text-sm text-text-secondary">
              <li class="flex items-start gap-3">
                <span class="mt-1.5 w-2 h-2 rounded-full bg-accent-coral flex-shrink-0"></span>
                <span>Managed asset pipeline and integration</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-1.5 w-2 h-2 rounded-full bg-accent-coral flex-shrink-0"></span>
                <span>Organized production flow using Trello</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-1.5 w-2 h-2 rounded-full bg-accent-coral flex-shrink-0"></span>
                <span>Maintained visual consistency with Photoshop adjustments</span>
              </li>
            </ul>
          </div>

          <!-- Card 3 -->
          <div class="bg-bg-card border border-border-default rounded-2xl p-5">
            <img src="/img/pizza/make-pizza.png" class="w-full h-40 object-cover rounded-xl mb-4" />

            <p class="text-sm font-semibold text-text-primary mb-3">Documentation & Team Coordination</p>

            <ul class="space-y-2 text-sm text-text-secondary">
              <li class="flex items-start gap-3">
                <span class="mt-1.5 w-2 h-2 rounded-full bg-accent-coral flex-shrink-0"></span>
                <span>Contributed to GDD updates</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-1.5 w-2 h-2 rounded-full bg-accent-coral flex-shrink-0"></span>
                <span>Recorded mechanic decisions</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-1.5 w-2 h-2 rounded-full bg-accent-coral flex-shrink-0"></span>
                <span>Maintained structured task tracking</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
<Footer />

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.querySelectorAll('[data-animate="fade-up"]').forEach((el) => {
    const delay = parseInt(el.getAttribute('data-delay') || '0') / 1000;

    gsap.from(el, {
      scrollTrigger: {
        trigger: el,
        start: 'top 85%',
        toggleActions: 'play none none none',
      },
      y: 30,
      opacity: 0,
      duration: 0.6,
      delay,
      ease: 'power2.out',
    });
  });
</script>

<script>
  const setupSlider = (id, intervalMs = 45000) => {
    const slides = Array.from(document.querySelectorAll(`img[data-slide="${id}"]`));
    const prevBtn = document.querySelector(`[data-prev="${id}"]`);
    const nextBtn = document.querySelector(`[data-next="${id}"]`);
    const dots = Array.from(document.querySelectorAll(`button[data-dot="${id}"]`));
    const container = document.querySelector(`[data-slider="${id}"]`);

    if (!slides.length) return;

    let index = 0;
    let timer = null;

    const render = (newIndex) => {
      index = (newIndex + slides.length) % slides.length;

      slides.forEach((el, i) => {
        el.classList.toggle('opacity-100', i === index);
        el.classList.toggle('opacity-0', i !== index);
      });

      dots.forEach((d, i) => {
        d.classList.toggle('bg-accent-coral', i === index);
        d.classList.toggle('bg-bg-card/60', i !== index);
      });
    };

    const start = () => {
      stop();
      timer = setInterval(() => render(index + 1), intervalMs);
    };

    const stop = () => {
      if (timer) clearInterval(timer);
      timer = null;
    };

    prevBtn?.addEventListener('click', () => {
      render(index - 1);
      start();
    });
    nextBtn?.addEventListener('click', () => {
      render(index + 1);
      start();
    });

    dots.forEach((d) => {
      d.addEventListener('click', () => {
        const i = parseInt(d.getAttribute('data-index') || '0', 10);
        render(i);
        start();
      });
    });

    container?.addEventListener('mouseenter', stop);
    container?.addEventListener('mouseleave', start);

    render(0);
    start();
  };

  // auto-init: pega todos os sliders da página
  document.querySelectorAll('[data-slider]').forEach((el) => {
    const id = el.getAttribute('data-slider');
    if (id) setupSlider(id);
    //if (id) setupSlider(id, 2000);
  });
</script>
